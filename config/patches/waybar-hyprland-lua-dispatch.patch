+// Hyprland runs a Lua config; its IPC rejects the legacy "dispatch <name> <arg>" syntax.
+static std::string luaStr(const std::string& s) {
+  std::string out = "\"";
+  for (char c : s) {
+    if (c == '"' || c == '\\') out += '\\';
+    out += c;
+  }
+  return out + "\"";
+}
